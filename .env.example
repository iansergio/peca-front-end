# URL base da API REST do backend, já com o prefixo /api e SEM barra no final.
# Lida só no servidor (Server Components e Server Actions); o navegador nunca
# chama o backend, então não é preciso CORS.
#   npm run dev:     http://localhost:8080/api
#   Docker Compose:  http://api:8080/api  (já definido no docker-compose.yml do backend)
API_URL=http://localhost:8080/api
